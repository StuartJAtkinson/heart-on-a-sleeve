{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    // TS 6+ tightened side-effect import resolution (TS2882). Pre-7 the
    // ambient `declare module '*.css'` in src/globals.d.ts was enough; TS 7
    // also wants the importer to declare noUncheckedSideEffectImports=false.
    // Safe to leave on for older TS — the option is a no-op there.
    "noUncheckedSideEffectImports": false
  },
  "include": ["src"]
}
